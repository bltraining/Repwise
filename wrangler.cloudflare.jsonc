{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repwise",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": false,
    "not_found_handling": "none"
  }
}
